# Copy to .env and adjust. All settings are optional in dev.
SATPI_ENVIRONMENT=dev
SATPI_STUDY_AREA_CONFIG=configs/study_areas/sw_pennsylvania.yaml
SATPI_DATA_ROOT=./data
SATPI_DATABASE_URL=postgresql://satpi:satpi@localhost:5432/satpi
SATPI_REDIS_URL=redis://localhost:6379/0
SATPI_MLFLOW_TRACKING_URI=
SATPI_LOG_LEVEL=INFO
# Leave empty to disable write/scenario endpoints (read-only public mode)
SATPI_API_AUTH_TOKEN=

# Dashboard basemap (see DATA_SOURCES.md §6). A free CARTO key is recommended:
# https://carto.com/basemaps/apikey  — or point the style URL at another provider.
SATPI_BASEMAP_API_KEY=
# SATPI_BASEMAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Local docker-compose database password (change for any shared deployment)
POSTGRES_PASSWORD=satpi
